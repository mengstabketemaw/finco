# Copy to .env (git-ignored) and fill in from Supabase: Project Settings → API.
# Both values are public by design (row-level security protects the data);
# the build bakes them into the app's login form.
PUBLIC_SUPABASE_URL=https://<project>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable or anon key>
